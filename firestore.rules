rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Attribute-Based Access Control (ABAC)
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidNovelCreate(data, novelId) {
      return data.id == novelId &&
             data.ownerId == request.auth.uid &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 500;
    }

    // Novel writing projects collection
    match /novels/{novelId} {
      // Single-document read: only the authenticated owner can read their project
      allow get: if isSignedIn() &&
                    isValidId(novelId) &&
                    resource.data.ownerId == request.auth.uid;

      // List queries: Query Enforcer strictly requires `where("ownerId", "==", request.auth.uid)`
      allow list: if isSignedIn() &&
                     resource.data.ownerId == request.auth.uid;

      // Project creation: caller must be authenticated and claim themselves as ownerId
      allow create: if isSignedIn() &&
                       isValidId(novelId) &&
                       isValidNovelCreate(request.resource.data, novelId);

      // Project update: only the owner can update; ownerId and project ID are immutable
      allow update: if isSignedIn() &&
                       isValidId(novelId) &&
                       resource.data.ownerId == request.auth.uid &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() > 0;

      // Project deletion: only the owner can delete their project
      allow delete: if isSignedIn() &&
                       isValidId(novelId) &&
                       resource.data.ownerId == request.auth.uid;

      // Explicitly authorized partitioned subcollections (Phase 2.2 & 2.2.1 Cloud Architecture)
      // Master Gate: verifies that the parent novel document is owned by the requesting user
      // Scene Document Integrity: ensures id == sceneId and novelId == novelId on create/update
      match /scenes/{sceneId} {
        allow read, delete: if isSignedIn() &&
                               isValidId(novelId) &&
                               isValidId(sceneId) &&
                               get(/databases/$(database)/documents/novels/$(novelId)).data.ownerId == request.auth.uid;

        allow create, update: if isSignedIn() &&
                                 isValidId(novelId) &&
                                 isValidId(sceneId) &&
                                 get(/databases/$(database)/documents/novels/$(novelId)).data.ownerId == request.auth.uid &&
                                 request.resource.data.id == sceneId &&
                                 request.resource.data.novelId == novelId;
      }

      // Board Document Integrity: ensures novelId == novelId on create/update
      match /boards/{boardId} {
        allow read, delete: if isSignedIn() &&
                               isValidId(novelId) &&
                               isValidId(boardId) &&
                               get(/databases/$(database)/documents/novels/$(novelId)).data.ownerId == request.auth.uid;

        allow create, update: if isSignedIn() &&
                                 isValidId(novelId) &&
                                 isValidId(boardId) &&
                                 get(/databases/$(database)/documents/novels/$(novelId)).data.ownerId == request.auth.uid &&
                                 request.resource.data.novelId == novelId;
      }

      match /data/{dataId} {
        allow read, delete: if isSignedIn() &&
                               isValidId(novelId) &&
                               isValidId(dataId) &&
                               get(/databases/$(database)/documents/novels/$(novelId)).data.ownerId == request.auth.uid;

        allow create, update: if isSignedIn() &&
                                 isValidId(novelId) &&
                                 isValidId(dataId) &&
                                 get(/databases/$(database)/documents/novels/$(novelId)).data.ownerId == request.auth.uid;
      }

      match /content/{contentId} {
        allow read, delete: if isSignedIn() &&
                               isValidId(novelId) &&
                               isValidId(contentId) &&
                               get(/databases/$(database)/documents/novels/$(novelId)).data.ownerId == request.auth.uid;

        allow create, update: if isSignedIn() &&
                                 isValidId(novelId) &&
                                 isValidId(contentId) &&
                                 get(/databases/$(database)/documents/novels/$(novelId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
